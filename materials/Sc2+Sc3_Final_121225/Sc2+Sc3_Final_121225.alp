				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764332123109</Id>
					<Name><![CDATA[updateCurrentDemand]]></Name>
					<X>80</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[callerRef]]></Name>
						<Type><![CDATA[I_Meter]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[amount]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (amount > 0) {
	hourlyBuyers.put(callerRef, amount);
	}
else if (amount < 0) {
	hourlySellers.put(callerRef, amount*(-1));
	}]]></Body>
				</Function>
				<Function AccessType="private" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764332443206</Id>
					<Name><![CDATA[distributeElectricity]]></Name>
					<X>270</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double totalElForSale = 0;
for (double value : hourlySellers.values()) {
	totalElForSale += value;
}

double totalElNeeded = 0;
for (double value : hourlyBuyers.values()) {
	totalElNeeded += value;
}

double salesCoefficient = 1;
double purchaseCoefficient = 1;

if (totalElForSale > totalElNeeded) {
	salesCoefficient = totalElNeeded / totalElForSale;
	purchaseCoefficient = 1;
}

else if (totalElForSale < totalElNeeded) {
	salesCoefficient = 1;
	purchaseCoefficient = totalElForSale / totalElNeeded;
}

for (I_Meter key : hourlySellers.keySet()) {
	key.setElFromPeerToPeer(this, hourlySellers.get(key)*salesCoefficient*(-1)); 
	key.setElFromSupplier(this, hourlySellers.get(key)*(1-salesCoefficient)*(-1));
}

for (I_Meter key : hourlyBuyers.keySet()) {
	key.setElFromPeerToPeer(this, hourlyBuyers.get(key)*purchaseCoefficient);
	key.setElFromSupplier(this, hourlyBuyers.get(key)*(1-purchaseCoefficient));
}]]></Body>
				</Function>
				<Function AccessType="private" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1765565628730</Id>
					<Name><![CDATA[updateSelfSufficiency]]></Name>
					<X>270</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (consumers.communityHourlyElFromSupplier() <= 0) {
	hourlySelfSufficiency = 1;
} else {
	hourlySelfSufficiency = max(0, 1 - (consumers.communityHourlyElFromSupplier() / consumers.communityHourlyElConsumption())); //Max function used to correct for minuscule rounding errors
}

totalSelfSufficiency += hourlySelfSufficiency;]]></Body>
				</Function>
			</Functions>
