					</Properties>
					<Action><![CDATA[currentConsumption = (double) selectFirstValue(double.class,
	"SELECT consumer_"+Integer.toString(consumer.getIndex()+1)+" FROM consumption_data WHERE " + 
		"time = ? LIMIT 1;",
