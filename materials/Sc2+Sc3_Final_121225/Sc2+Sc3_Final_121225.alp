				<Function AccessType="private" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764339543612</Id>
					<Name><![CDATA[updatePeerToPeer]]></Name>
					<X>210</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (Meter.getElFromPeerToPeer(this) < 0) {
	earnedRevenue += Meter.getElFromPeerToPeer(this)*main.supplier.getHourlyElPrice(this)*(-0.5);
}	

totalBillPeerToPeer += Meter.getElFromPeerToPeer(this)*main.supplier.getHourlyElPrice(this)*0.5;]]></Body>
				</Function>
