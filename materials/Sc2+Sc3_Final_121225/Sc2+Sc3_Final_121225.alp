					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (Meter.getElFromSupplier(this) < 0) {
	earnedRevenue += Meter.getElFromSupplier(this)*main.supplier.getHourlyElPrice(this)*(-0.2);
}]]></Body>
				</Function>
