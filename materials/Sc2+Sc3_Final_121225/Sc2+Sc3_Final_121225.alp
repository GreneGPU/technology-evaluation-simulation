			<Events>
				<Event>
					<Id>1761553747910</Id>
					<Name><![CDATA[dataUpdater]]></Name>
					<X>70</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1761553747908</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1761638400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[hourlyElPrice = (double) selectFirstValue(double.class,
	"SELECT DK_1_price_day_ahead FROM el_data WHERE " + 
		"time = ? LIMIT 1;",
		addToDate(date(), YEAR, -5) //Change if simulation start != 2020
)*7.46/100; //Check the source

hourlyEmissions = (double) selectFirstValue(double.class,
	"SELECT co2_perk_wh_proportional FROM co2_emissions WHERE " + 
		"hour_dk = ? LIMIT 1;",
		addToDate(date(), YEAR, -5) //Change if simulation start != 2020
)]]></Action>
				</Event>
				<Event>
					<Id>1763486621734</Id>
					<Name><![CDATA[billUpdater]]></Name>
					<Description><![CDATA[Only includes the electricity purchased directly from supplier]]></Description>
					<X>70</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1763486621732</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1763539200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0.004]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[for (I_Meter key : hourlyConsumption.keySet() ){
	if (hourlyConsumption.get(key) >= 0)
		{hourlyBill.put(key, hourlyConsumption.get(key)*hourlyElPrice);}
	else
		{hourlyBill.put(key, hourlyConsumption.get(key)*hourlyElPrice*0.2);}
	
	if (totalBill.containsKey(key))
		totalBill.put(key, totalBill.get(key) + hourlyBill.get(key));
	else
		totalBill.put(key, hourlyBill.get(key));
}]]></Action>
				</Event>
			</Events>
